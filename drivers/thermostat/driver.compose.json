{
  "name": { "en": "Themo Smart Thermostat" },
  "class": "thermostat",
  "platforms": ["local"],
  "connectivity": ["cloud"],
  "icon": "/drivers/thermostat/assets/icon.svg",
  "images": {
    "small": "/drivers/thermostat/assets/images/small.png",
    "large": "/drivers/thermostat/assets/images/large.png",
    "xlarge": "/drivers/thermostat/assets/images/xlarge.png"
  },
  "capabilities": [
    "measure_temperature",
    "measure_temperature.floor",
    "target_temperature",
    "thermostat_mode",
    "measure_power",
    "themo_heating",
    "themo_schedule"
  ],
  "capabilitiesOptions": {
    "measure_temperature": { "title": { "en": "Room Temperature" }, "decimals": 1 },
    "measure_temperature.floor": { "title": { "en": "Floor Temperature" }, "decimals": 1 },
    "target_temperature": { "min": 5, "max": 41, "step": 0.5, "decimals": 1 },
    "measure_power": {
      "title": { "en": "Heating Power" },
      "decimals": 0,
      "approximated": true
    },
    "thermostat_mode": {
      "values": [
        { "id": "auto", "title": { "en": "Automatic" } },
        { "id": "heat", "title": { "en": "Heat" } },
        { "id": "off", "title": { "en": "Off" } }
      ]
    }
  },
  "pair": [
    {
      "id": "login_credentials",
      "template": "login_credentials",
      "options": {
        "title": { "en": "Themo account" },
        "usernameLabel": { "en": "E-mail address" },
        "usernamePlaceholder": { "en": "you@example.com" },
        "passwordLabel": { "en": "Password" }
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": { "next": "add_devices", "prev": "login_credentials" }
    },
    { "id": "add_devices", "template": "add_devices" }
  ],
  "repair": [
    {
      "id": "login_credentials",
      "template": "login_credentials",
      "options": {
        "title": { "en": "Themo account" },
        "usernameLabel": { "en": "E-mail address" },
        "usernamePlaceholder": { "en": "you@example.com" },
        "passwordLabel": { "en": "Password" }
      }
    }
  ],
  "settings": [
    {
      "id": "poll_interval",
      "type": "number",
      "label": { "en": "Poll interval" },
      "hint": { "en": "How often Homey requests the latest status from Themo. Lower values update faster but use more cloud traffic." },
      "value": 120,
      "units": { "en": "seconds" },
      "attr": {
        "min": 30,
        "max": 900,
        "step": 10
      }
    }
  ]
}
