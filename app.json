{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.esko.themo",
  "version": "1.0.7",
  "compatibility": ">=12.4.5",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Themo"
  },
  "description": {
    "en": "Heat your floors using affordable exchange electricity"
  },
  "category": [
    "climate"
  ],
  "tags": {
    "en": [
      "themo",
      "thermostat",
      "floor heating"
    ]
  },
  "permissions": [],
  "brandColor": "#52469A",
  "images": {
    "small": "/assets/images/small.jpg",
    "large": "/assets/images/large.jpg",
    "xlarge": "/assets/images/xlarge.jpg"
  },
  "author": {
    "name": "Esko Pyyluoma",
    "email": "esko.pyyluoma@gmail.com"
  },
  "source": "https://github.com/esko/themo-homey",
  "bugs": {
    "url": "https://github.com/esko/themo-homey/issues"
  },
  "support": "mailto:esko.pyyluoma@gmail.com",
  "flow": {
    "triggers": [
      {
        "id": "floor_temperature_changed",
        "title": {
          "en": "The floor temperature changed"
        },
        "tokens": [
          {
            "name": "temperature",
            "type": "number",
            "title": {
              "en": "Temperature"
            },
            "example": 24.5
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat"
          }
        ]
      },
      {
        "id": "heating_started",
        "title": {
          "en": "Started heating"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat"
          }
        ]
      },
      {
        "id": "heating_stopped",
        "title": {
          "en": "Stopped heating"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat"
          }
        ]
      },
      {
        "id": "schedule_changed",
        "title": {
          "en": "The active schedule changed"
        },
        "tokens": [
          {
            "name": "schedule",
            "type": "string",
            "title": {
              "en": "Schedule"
            },
            "example": "Weekday"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "floor_temperature_above",
        "title": {
          "en": "The floor temperature is !{{above|below}}"
        },
        "titleFormatted": {
          "en": "The floor temperature is !{{above|below}} [[temperature]]°C"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat"
          },
          {
            "name": "temperature",
            "type": "number",
            "min": 0,
            "max": 50,
            "step": 0.5,
            "placeholder": {
              "en": "°C"
            }
          }
        ]
      },
      {
        "id": "is_heating",
        "title": {
          "en": "Is !{{heating|not heating}}"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Themo Smart Thermostat"
      },
      "class": "thermostat",
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "icon": "/drivers/thermostat/assets/icon.svg",
      "images": {
        "small": "/drivers/thermostat/assets/images/small.png",
        "large": "/drivers/thermostat/assets/images/large.png",
        "xlarge": "/drivers/thermostat/assets/images/xlarge.png"
      },
      "capabilities": [
        "measure_temperature",
        "measure_temperature.floor",
        "target_temperature",
        "thermostat_mode",
        "measure_power",
        "themo_heating",
        "themo_schedule"
      ],
      "capabilitiesOptions": {
        "measure_temperature": {
          "title": {
            "en": "Room Temperature"
          },
          "decimals": 1
        },
        "measure_temperature.floor": {
          "title": {
            "en": "Floor Temperature"
          },
          "decimals": 1
        },
        "target_temperature": {
          "min": 5,
          "max": 41,
          "step": 0.5,
          "decimals": 1
        },
        "measure_power": {
          "title": {
            "en": "Heating Power"
          },
          "decimals": 0,
          "approximated": true
        },
        "thermostat_mode": {
          "values": [
            {
              "id": "auto",
              "title": {
                "en": "Automatic"
              }
            },
            {
              "id": "heat",
              "title": {
                "en": "Heat"
              }
            },
            {
              "id": "off",
              "title": {
                "en": "Off"
              }
            }
          ]
        }
      },
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "title": {
              "en": "Themo account"
            },
            "usernameLabel": {
              "en": "E-mail address"
            },
            "usernamePlaceholder": {
              "en": "you@example.com"
            },
            "passwordLabel": {
              "en": "Password"
            }
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices",
            "prev": "login_credentials"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "title": {
              "en": "Themo account"
            },
            "usernameLabel": {
              "en": "E-mail address"
            },
            "usernamePlaceholder": {
              "en": "you@example.com"
            },
            "passwordLabel": {
              "en": "Password"
            }
          }
        }
      ],
      "settings": [
        {
          "id": "poll_interval",
          "type": "number",
          "label": {
            "en": "Poll interval"
          },
          "hint": {
            "en": "How often Homey requests the latest status from Themo. Lower values update faster but use more cloud traffic."
          },
          "value": 120,
          "units": {
            "en": "seconds"
          },
          "attr": {
            "min": 30,
            "max": 900,
            "step": 10
          }
        }
      ],
      "id": "thermostat"
    }
  ],
  "capabilities": {
    "themo_heating": {
      "type": "boolean",
      "title": {
        "en": "Heating"
      },
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/themo_heating.svg",
      "titleTrue": {
        "en": "Heating"
      },
      "titleFalse": {
        "en": "Idle"
      },
      "insightsTitleTrue": {
        "en": "Started heating"
      },
      "insightsTitleFalse": {
        "en": "Stopped heating"
      }
    },
    "themo_schedule": {
      "type": "string",
      "title": {
        "en": "Active Schedule"
      },
      "getable": true,
      "setable": false,
      "insights": false,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/themo_schedule.svg"
    }
  }
}